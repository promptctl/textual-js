# The capture environment, in one place.
#
# [LAW:one-source-of-truth] A fixture's baselines are produced by two different
# execution paths — render-fixture-xvfb.sh drives a real xterm to make the PNG,
# capture_python.py drives a headless compositor to make the cell grid. They
# describe the same frame only if they run the app under the same environment.
# When that environment lived in both files, they disagreed: progress_indeterminate's
# JSON recorded an unhighlighted rail while its PNG recorded a fully highlighted
# bar, because one path disabled Textual's animations and the other did not.
#
# Every capture path applies this file whole. There is no per-path subset — a
# subset is how the two drift back apart. [LAW:dataflow-not-control-flow]
#
# Format is KEY=VALUE, one per line, no quoting or expansion, so a shell can
# `source` it and Python can split it on the first `=`.

# Textual's animation system produces non-identical frames forever, which defeats
# screenshot-stability detection and makes any single captured frame arbitrary.
TEXTUAL_ANIMATIONS=none

# Force themed colors out as #RRGGBB rather than 256-color approximations.
# Without it the two implementations cannot be compared at AE == 0 at all.
TEXTUAL_COLOR_SYSTEM=truecolor

# Rich/Textual color-depth forcing, for the same reason. xterm resets TERM and
# COLORTERM for its child process, so FORCE_COLOR is what actually reaches the
# fixture on the real-terminal path.
FORCE_COLOR=3

# Selects the truecolor terminfo entry and advertises 24-bit color. Consumed by
# xterm itself on the real-terminal path; harmless and consistent elsewhere.
COLORTERM=truecolor
TERM=xterm-direct
