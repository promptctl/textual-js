{
  "name": "textual-js",
  "version": "0.0.1",
  "description": "Terminal UI application framework built on React/Ink — a TypeScript port of Python's Textual",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsx scripts/check-framework-imports.ts",
    "clean": "rm -rf dist",
    "visual": "bash visual-tests/run.sh",
    "visual:update-python": "bash visual-tests/update-python-baselines.sh"
  },
  "keywords": [
    "tui",
    "terminal",
    "textual",
    "widget",
    "react",
    "ink",
    "mobx",
    "tcss",
    "css"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.14",
    "css-tree": "^3.1.0",
    "ink": "^5.2.0",
    "marked": "^15.0.0",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rich-js": "file:../rich-js",
    "shiki": "^1.24.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.10",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
